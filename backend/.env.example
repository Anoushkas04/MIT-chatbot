GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDINGS_ENABLED=false

# Chat provider: auto | openai | anthropic | gemini | local
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=90

# Hybrid RAG. Visual indexing needs sentence-transformers[image]/peft (not installed
# by default — see requirements.txt) and is opt-in because the first run downloads
# model weights.
VISUAL_RAG_ENABLED=false
VISUAL_RAG_SCOPE=scanned
COLVISION_MODEL=vidore/colSmol-500M
COLVISION_DEVICE=auto
COLVISION_LOCAL_FILES_ONLY=false
# Optional but recommended for reliable Hugging Face checkpoint downloads.
HF_TOKEN=
RAG_TOP_K_VISUAL=8
RAG_TOP_K_TEXT=12
RAG_FINAL_K=4
RAG_RENDER_DPI=144

# Offline OCR for scanned pages, via rapidocr-onnxruntime (not installed by default
# — see requirements.txt). Left off locally so scanned-page handling is simply
# skipped instead of failing; install the package and flip this on to enable it.
LOCAL_OCR_ENABLED=false
OCR_MIN_CONFIDENCE=0.45
OCR_MAX_IMAGE_EDGE=2600
# OCR_CACHE_DIR=./data/ocr_cache

# Supabase Auth — generates, emails (via your custom SMTP, e.g. Gmail) and verifies OTP codes
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Allowed Email Domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=learner.manipal.edu,manipal.edu

# Database — leave empty for local SQLite (campus_os.db). For deployment, use the Supabase
# Postgres connection string (Project Settings → Database → Connection pooling URI).
DATABASE_URL=

# Signs login session tokens. Use a long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SESSION_SECRET=

# Local testing only: with Supabase unset, return the OTP in the API response (the sign-in page shows it)
AUTH_DEV_MODE=false

# Admins are fixed in backend/app/config.py (ADMIN_ACCOUNTS); there is no admin setting here.

# Set to 1 to seed labelled sample questions into an empty Community feed (demos only)
SEED_DEMO_COMMUNITY=

# Browser origins allowed to call the API (comma-separated). Defaults to http://localhost:3000.
# Add your LAN address or deployed frontend URL here.
CORS_ORIGINS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDINGS_ENABLED=false

# Chat provider: auto | openai | anthropic | gemini | local
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=90

# Hybrid RAG. Visual indexing is opt-in because the first run downloads model weights.
VISUAL_RAG_ENABLED=false
VISUAL_RAG_SCOPE=scanned
COLVISION_MODEL=vidore/colSmol-500M
COLVISION_DEVICE=auto
COLVISION_LOCAL_FILES_ONLY=false
# Optional but recommended for reliable Hugging Face checkpoint downloads.
HF_TOKEN=
RAG_TOP_K_VISUAL=8
RAG_TOP_K_TEXT=12
RAG_FINAL_K=4
RAG_RENDER_DPI=144

# Offline OCR for scanned pages. RapidOCR runs locally and caches page output.
LOCAL_OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.45
OCR_MAX_IMAGE_EDGE=2600
# OCR_CACHE_DIR=./data/ocr_cache

# Supabase Auth — generates, emails (via your custom SMTP, e.g. Gmail) and verifies OTP codes
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Allowed Email Domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=learner.manipal.edu,manipal.edu

# Database — leave empty for local SQLite (campus_os.db). For deployment, use the Supabase
# Postgres connection string (Project Settings → Database → Connection pooling URI).
DATABASE_URL=

# Signs login session tokens. Use a long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SESSION_SECRET=
SESSION_TTL_DAYS=7

# Local testing only: with Supabase unset, return the OTP in the API response (the sign-in page shows it)
AUTH_DEV_MODE=false

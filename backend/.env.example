GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001

# Chat provider: auto | openai | anthropic | gemini | local
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=90

# Hybrid RAG. Visual indexing is opt-in because the first run downloads model weights.
VISUAL_RAG_ENABLED=false
VISUAL_RAG_SCOPE=scanned
COLVISION_MODEL=vidore/colSmol-500M
COLVISION_DEVICE=auto
COLVISION_LOCAL_FILES_ONLY=false
# Optional but recommended for reliable Hugging Face checkpoint downloads.
HF_TOKEN=
RAG_TOP_K_VISUAL=8
RAG_TOP_K_TEXT=12
RAG_FINAL_K=4
RAG_RENDER_DPI=144

# Supabase Auth Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Allowed Email Domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=learner.manipal.edu,manipal.edu
